{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataDir": ".runtime-data",
  "Auth": {
    "Seed": {
      "admin": "Administrator",
      "operador": "Operator",
      "ingeniero": "Engineer",
      "observador": "Viewer"
    }
  },
  "LabProfiles": {
    "siemens-s7": {
      "TargetPluginId": "siemens-s7",
      "DisplayName": "Siemens S7 probe",
      "Executable": "wsl.exe",
      "Arguments": ["-d", "AtlasUbuntu", "-u", "root", "--", "python3", "/mnt/c/Users/Admin/source/repos/AtlasPLC/.runtime-simulators/snap7_probe.py"],
      "TimeoutSeconds": 30
    },
    "rockwell-logix": {
      "TargetPluginId": "rockwell-logix",
      "DisplayName": "Rockwell EtherNet/IP probe",
      "Executable": "wsl.exe",
      "Arguments": ["-d", "AtlasUbuntu", "-u", "root", "--", "bash", "-lc", "python3 -m cpppo.server.enip.client -a 127.0.0.1:44818 -p 'Atlas_Start=(BOOL)1'"],
      "TimeoutSeconds": 30
    },
    "mitsubishi-melsec": {
      "TargetPluginId": "mitsubishi-melsec",
      "DisplayName": "Mitsubishi SLMP probe",
      "Executable": "dotnet",
      "Arguments": ["run", "--project", ".runtime-simulators\\SLMP\\SLMP.Examples\\SLMP.Examples.csproj", "--no-restore", "--", "127.0.0.1", "2000"],
      "TimeoutSeconds": 30
    },
    "omron-sysmac": {
      "TargetPluginId": "omron-sysmac",
      "DisplayName": "Omron FINS probe",
      "Executable": "wsl.exe",
      "Arguments": ["-d", "AtlasUbuntu", "-u", "root", "--", "bash", "-lc", "cd /mnt/c/Users/Admin/source/repos/AtlasPLC/.runtime-simulators/gofins && go run ./example"],
      "TimeoutSeconds": 30
    },
    "beckhoff-twincat": {
      "TargetPluginId": "beckhoff-twincat",
      "DisplayName": "Beckhoff ADS probe",
      "Executable": "dotnet",
      "Arguments": ["run", "--project", ".runtime-simulators\\AdsProbe\\AdsProbe.csproj", "--no-restore"],
      "TimeoutSeconds": 30
    }
  }
}
