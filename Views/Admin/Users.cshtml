@model AtlasSoftPlc.Web.Controllers.AdminUsersViewModel
@{ ViewData["Title"] = "Administración de usuarios"; }
<h1>Administración de usuarios</h1>
<p class="text-muted">Gestiona cuentas y permisos del Workbench. Sólo Administrador puede acceder.</p>
@if (TempData["AdminMessage"] is string message) { <div class="alert alert-info">@message</div> }
<section class="card mb-4"><div class="card-header">Crear o actualizar usuario</div><div class="card-body"><form asp-action="SaveUser" method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-3"><label class="form-label">Usuario</label><input name="username" class="form-control" minlength="3" maxlength="64" required /></div><div class="col-md-3"><label class="form-label">Nombre visible</label><input name="displayName" class="form-control" /></div><div class="col-md-3"><label class="form-label">Contraseña</label><input name="password" type="password" class="form-control" required /></div><div class="col-md-2"><label class="form-label">Rol</label><select name="role" class="form-select">@foreach (var role in Model.Roles) { <option value="@role">@role</option> }</select></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100">Guardar</button></div></form></div></section>
<section class="card"><div class="card-header">Cuentas persistidas</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th></tr></thead><tbody>@foreach (var user in Model.Users) { <tr><td>@user.Username</td><td>@user.DisplayName</td><td><span class="badge text-bg-secondary">@user.Role</span></td></tr> }</tbody></table></div></section>
