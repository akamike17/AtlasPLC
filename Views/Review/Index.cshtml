@model AtlasSoftPlc.Web.Controllers.ReviewViewModel
@{ ViewData["Title"] = "Revisión del proyecto"; var blocked = Model.Report.Issues.Count > 0; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Revisión: @Model.Program.Name</h1><p class="text-muted mb-0">Validación antes de simular o enviar al target.</p></div><span class="badge fs-6 @(blocked ? "text-bg-danger" : "text-bg-success")">@(blocked ? "BLOQUEADO" : "LISTO PARA PRUEBA")</span></div>
<div class="row g-3 mb-3"><div class="col-md-3"><div class="card"><div class="card-body"><strong>Variables</strong><div class="display-6">@Model.Program.Variables.Count</div></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><strong>Reglas</strong><div class="display-6">@Model.Program.Logic.Rules.Count</div></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><strong>Versiones</strong><div class="display-6">@Model.History.Count</div></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><strong>Hallazgos</strong><div class="display-6">@Model.Report.Issues.Count</div><small>@Model.Report.ErrorCount errores · @Model.Report.WarningCount advertencias</small></div></div></div></div>
<div class="small text-muted mb-3">Identidad revisada: <code>@Model.Program.Hash</code> · Última versión persistida: @(Model.History.OrderByDescending(v => v.VersionNumber).FirstOrDefault()?.Hash ?? "sin historial")</div>
@if (Model.Report.Issues.Count == 0) { <div class="alert alert-success">Construcción limpia: no hay advertencias ni errores. Puedes observar el simulador y ejecutar la prueba del target.</div> }
else { <div class="card border-danger"><div class="card-header bg-danger text-white">Envío bloqueado: corrige todos los hallazgos</div><div class="card-body">@foreach (var issue in Model.Report.Issues) { <div class="border-bottom py-2"><strong>[@issue.Severity] @issue.Message</strong><div class="small text-muted">Por qué: @issue.Why</div><div class="small">Hint: @issue.Hint</div></div> }</div></div> }
@if (TempData["ReviewMessage"] is string msg) { <div class="alert alert-info mt-3">@msg</div> }
@if (Model.History.Count > 0) { <section class="card mt-3"><div class="card-header"><strong>Historial, comparación y restauración</strong></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Versión</th><th>Fecha</th><th>Autor</th><th>Motivo</th><th>Acciones</th></tr></thead><tbody>@foreach (var version in Model.History.OrderByDescending(v => v.VersionNumber)) { <tr><td>v@version.VersionNumber</td><td>@version.CreatedUtc.ToLocalTime().ToString("g")</td><td>@version.CreatedBy</td><td>@version.Reason</td><td class="text-nowrap"><form class="d-inline" asp-controller="Home" asp-action="RestoreVersion" method="post">@Html.AntiForgeryToken()<input type="hidden" name="versionId" value="@version.Id" /><button type="submit" class="btn btn-sm btn-outline-warning">Restaurar</button></form></td></tr> }</tbody></table></div></div><div class="card-footer"><form asp-action="Compare" method="get" class="row g-2 align-items-end"><div class="col-auto"><label class="form-label small">Versión base</label><select name="leftId" class="form-select form-select-sm">@foreach (var version in Model.History.OrderByDescending(v => v.VersionNumber)) { <option value="@version.Id">v@version.VersionNumber</option> }</select></div><div class="col-auto"><label class="form-label small">Versión a comparar</label><select name="rightId" class="form-select form-select-sm">@foreach (var version in Model.History.OrderByDescending(v => v.VersionNumber)) { <option value="@version.Id">v@version.VersionNumber</option> }</select></div><div class="col-auto"><button class="btn btn-sm btn-outline-primary">Comparar versiones</button></div></form><div class="small text-muted mt-2">La restauración crea una nueva carga segura; no sobrescribe las versiones inmutables.</div></div></section> }
<div class="mt-3 d-flex gap-2"><a asp-controller="Home" asp-action="Simulation" class="btn btn-primary">Corregir en el simulador</a>@if (!blocked) { <form asp-action="Send" method="post"><button class="btn btn-success" type="submit">Validar y regresar al simulador</button></form> } else { <button class="btn btn-secondary" disabled title="Corrige todos los hallazgos antes de enviar">Envío bloqueado</button> }</div>
