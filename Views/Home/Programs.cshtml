@model AtlasSoftPlc.Web.Controllers.ProgramsViewModel
@{
    ViewData["Title"] = "Biblioteca de programas";
}

<h2>Biblioteca de programas</h2>
<p class="text-muted">Programas PLC disponibles dentro de Atlas SoftPLC.</p>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">PROGRAMAS</div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Versión</th>
                    <th>Descripción</th>
                    <th style="width:120px;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Catalog)
                {
                    var isActive = p.Id == Model.ActiveProgramId;
                    <tr class="@(isActive ? "table-success" : "")">
                        <td>
                            @p.Name
                            @if (isActive)
                            {
                                <span class="badge bg-success ms-1">ACTIVO</span>
                            }
                        </td>
                        <td>v@(p.Version)</td>
                        <td class="text-muted">@p.Description</td>
                        <td>
                            @if (!isActive)
                            {
                                <form asp-controller="Home" asp-action="LoadProgram" method="post">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Cargar</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">En ejecución</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-dark text-white">PROGRAMA ACTIVO</div>
    <div class="card-body">
        @{
            var active = Model.Catalog.FirstOrDefault(p => p.Id == Model.ActiveProgramId);
        }
        @if (active is null)
        {
            <p class="text-muted">Ningún programa cargado.</p>
        }
        else
        {
            <p class="mb-1"><strong>@active.Name</strong> <span class="text-muted">v@(active.Version)</span></p>
            <p class="small text-muted mb-0">Estado runtime: @Model.Runtime.State</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al Dashboard</a>
</div>
