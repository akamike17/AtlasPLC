# ── Variables de entorno para DESPLIEGUE EN PRODUCCIÓN ──
# Cópialo a `.env` (nunca commities .env) o expórtalas como variables de entorno reales.
# ASP.NET Core lee automáticamente toda variable de entorno que mapee a la clave config.

# Dominio(s) permitido(s) para el host header (anti host-header-injection).
# Debe ser el FQDN real del despliegue.
ASPNETCORE_AllowedHosts=plc.ejemplo.com

# Contraseña de semilla de usuarios (SOLO se usa para el seed inicial; no persiste en código).
# El usuario admin se crea con esta contraseña la primera vez que la BD está vacía.
Auth__SeedPassword=REEMPLAZAR_CON_UNA_CONTRASENA_SEGURA

# Usuarios de semilla (formato: Auth__Seed__<usuario>=<rol>).
# Elimina estos valores una vez creados los usuarios reales.
Auth__Seed__admin=Administrator
Auth__Seed__operador=Operator

# ── Parámetros de endurecimiento de auth (opcional, tiene valores por defecto) ──
Auth__MaxFailedAttempts=5
Auth__MaxAttemptsPerWindow=20
Auth__LockoutDuration=00:15:00
Auth__RateLimitWindow=00:01:00

# ── Ruta de la BD (opcional; por defecto %LocalAppData%/AtlasSoftPlc/atlas.db) ──
# DataDir=C:\ProgramData\AtlasSoftPlc