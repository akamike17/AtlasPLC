{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Auth": {
    "MaxFailedAttempts": 5,
    "MaxAttemptsPerWindow": 20,
    "LockoutDuration": "00:15:00",
    "RateLimitWindow": "00:01:00"
  },
  "Modbus": {
    "Enabled": false,
    "Host": "127.0.0.1",
    "Port": 502,
    "UnitId": 1,
    "TimeoutMs": 1000,
    "Retries": 2,
    "CycleMs": 100,
    "MaxConnectAttempts": 3,
    "Map": {
      "LowLevelSensor": "coil:0",
      "HighLevelSensor": "coil:1",
      "EmergencyStop": "coil:2",
      "Pump": "coil:10"
    }
  }
}
